    {
      "cell_type": "code",
      "source": [
          "import re\\n",
          "import pandas as pd # Ensure pandas is imported\\n",
          "\\n",
          "THEMATIC_CODES = {\\n",
          "    \\"ECON_OPPORTUNITY\\": {\\n",
          "        \\"description\\": \\"Captures mentions of positive economic impacts, such as job creation, economic growth, increased productivity, or new business opportunities.\\",\\n",
          "        \\"keywords\\": [\\"job creation\\", \\"economic growth\\", \\"increased productivity\\", \\"new business opportunities\\", \\"boost economy\\", \\"new kinds of jobs\\", \\"economic benefit\\", \\"wealth creation\\", \\"innovation fund\\", \\"economic prosperity\\"]\\n",
          "    },\\n",
          "    \\"ECON_THREAT\\": {\\n",
          "        \\"description\\": \\"Captures mentions of negative economic impacts, such as job displacement, wage depression, or increased economic inequality.\\",\\n",
          "        \\"keywords\\": [\\"job displacement\\", \\"wage depression\\", \\"economic inequality\\", \\"losing my job\\", \\"lose jobs\\", \\"automation replacing jobs\\", \\"economic threat\\", \\"job losses\\", \\"unemployment\\", \\"economic decline\\"]\\n",
          "    },\\n",
          "    \\"GOVERNANCE_REGULATION\\": {\\n",
          "        \\"description\\": \\"Captures mentions of the need for rules, laws, government oversight, or control over AI development and deployment.\\",\\n",
          "        \\"keywords\\": [\\"rules\\", \\"laws\\", \\"government oversight\\", \\"control ai\\", \\"regulations\\", \\"keep it safe\\", \\"policy\\", \\"legislation\\", \\"governance\\", \\"oversight\\", \\"accountability\\", \\"frameworks\\", \\"standards\\"]\\n",
          "    },\\n",
          "    \\"ETHICS_BIAS\\": {\\n",
          "        \\"description\\": \\"Captures mentions of fairness, discrimination, algorithmic bias, or moral considerations.\\",\\n",
          "        \\"keywords\\": [\\"fairness\\", \\"discrimination\\", \\"algorithmic bias\\", \\"moral\\", \\"biased\\", \\"ethical\\", \\"values\\", \\"equity\\", \\"justice\\", \\"transparency\\", \\"accountable ai\\", \\"responsible ai\\"]\\n",
          "    },\\n",
          "    \\"HEALTHCARE_BENEFIT\\": {\\n",
          "        \\"description\\": \\"Captures mentions of positive impacts on health, medicine, disease diagnosis, or drug discovery.\\",\\n",
          "        \\"keywords\\": [\\"health\\", \\"medicine\\", \\"disease diagnosis\\", \\"drug discovery\\", \\"cures\\", \\"cancer\\", \\"healthcare\\", \\"medical\\", \\"patient\\", \\"treatment\\", \\"well-being\\", \\"medical advances\\", \\"health outcomes\\"]\\n",
          "    },\\n",
          "    \\"EXISTENTIAL_RISK\\": {\\n",
          "        \\"description\\": \\"Captures mentions of large-scale, catastrophic, or humanity-level risks, including loss of human control or superintelligence.\\",\\n",
          "        \\"keywords\\": [\\"large-scale risk\\", \\"catastrophic risk\\", \\"humanity-level risk\\", \\"loss of human control\\", \\"superintelligence\\", \\"dangerous for humanity\\", \\"existential risk\\", \\"skynet\\", \\"rogue ai\\", \\"human extinction\\", \\"uncontrolled ai\\"]\\n",
          "    },\\n",
          "    \\"SURVEILLANCE_PRIVACY\\": {\\n",
          "        \\"description\\": \\"Captures mentions of monitoring, data privacy, and government or corporate surveillance.\\",\\n",
          "        \\"keywords\\": [\\"monitoring\\", \\"data privacy\\", \\"government surveillance\\", \\"corporate surveillance\\", \\"use my data\\", \\"tracking\\", \\"privacy\\", \\"surveillance\\", \\"data protection\\", \\"personal data\\", \\"invasion of privacy\\"]\\n",
          "    }\\n",
          "}\\n",
          "\\n",
          "def apply_thematic_code(text, code_details):\\n",
          "    if not isinstance(text, str):\\n",
          "        return False\\n",
          "    text_lower = text.lower()\\n",
          "    for keyword in code_details[\\"keywords\\"]:\\n",
          "        if re.search(r'\\\\b' + re.escape(keyword.lower()) + r'\\\\b', text_lower):\\n",
          "            return True\\n",
          "    return False\\n",
          "\\n",
          "def apply_all_thematic_codes(text):\\n",
          "    applied_codes = {}\\n",
          "    if not isinstance(text, str):\\n",
          "      for code_name in THEMATIC_CODES:\\n",
          "        applied_codes[code_name] = False\\n",
          "      return applied_codes\\n",
          "    for code_name, code_details in THEMATIC_CODES.items():\\n",
          "        applied_codes[code_name] = apply_thematic_code(text, code_details)\\n",
          "    return applied_codes\\n",
          "\\n",
          "def add_thematic_codes_to_df(df, text_column='English Responses'):\\n",
          "    if text_column not in df.columns:\\n",
          "        for code_name in THEMATIC_CODES.keys():\\n",
          "            df[code_name] = False\\n",
          "        return df\\n",
          "    \\n",
          "    temp_codes_list = []\\n",
          "    for text_entry in df[text_column]:\\n",
          "        temp_codes_list.append(apply_all_thematic_codes(text_entry))\\n",
          "    \\n",
          "    codes_df = pd.DataFrame(temp_codes_list, index=df.index) \\n",
          "    \\n",
          "    for code_name in THEMATIC_CODES.keys():\\n",
          "        if code_name in codes_df.columns:\\n",
          "             df[code_name] = codes_df[code_name]\\n",
          "        else:\\n",
          "             df[code_name] = False\\n",
          "    return df\\n",
          "\\n",
          "print(\\"Thematic coding functions defined.\\")"
      ],
