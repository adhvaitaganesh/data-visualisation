        "    indices_df = pd.DataFrame()\\n",
        "else:\\n",
        "    all_opinion_df = pd.concat(processed_opinion_dfs, ignore_index=True)\\n",
        "    print(f\\"Total 'Ask Opinion' responses aggregated for analysis: {len(all_opinion_df)}\\")\\n",
        "\\n",
        "    if not segment_columns and not all_opinion_df.empty: \\n",
        "        print(\\"Attempting to infer segment columns from aggregated opinion DataFrame (fallback)...\\")\\n",
        "        potential_segments = []\\n",
        "        known_non_segment_cols = ['English Responses', 'sentiment_score'] + list(THEMATIC_CODES.keys()) + \\\\\\n",
