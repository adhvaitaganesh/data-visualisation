        "                                  'Response ID', 'Participant ID', 'embedding', 'cosine_similarity', \\\\\\n",
        "                                  'bridge', 'polarization', 'divergence']\\n",
        "        for col in all_opinion_df.columns:\\n",
        "            is_potential_segment = True\\n",
        "            if col in known_non_segment_cols:\\n",
        "                is_potential_segment = False\\n",
        "            elif col.startswith('Unnamed'): \\n",
        "                is_potential_segment = False\\n",
        "            if is_potential_segment:\\n",
        "                 if ('(' in col and ')' in col) or \\"All\\" in col:\\n",
        "                    potential_segments.append(col)\\n",
        "\\n",
        "        if potential_segments:\\n",
        "            segment_columns = sorted(list(set(potential_segments)))\\n",
        "            print(f\\"Fallback identified Segment Columns: {segment_columns}\\")\\n",
        "        else:\\n",
        "            print(\\"Fallback segment identification also failed.\\")\\n",
        "            \\n",
        "    if not segment_columns:\\n",
        "        print(\\"CRITICAL: No segment columns identified. Index calculation will be skipped.\\")\\n",
        "        indices_df = pd.DataFrame()\\n",
        "    else:\\n",
        "        country_level_indices = []\\n",
        "        for segment_name in segment_columns:\\n",
        "            country_data = all_opinion_df \\n",
        "            total_responses = len(country_data)\\n",
        "\\n",
        "            if total_responses == 0:\\n",
        "                country_level_indices.append({'Country/Segment': segment_name, 'AIOI': np.nan, 'EAI': np.nan, 'GECI': np.nan, 'DSS': np.nan, 'TotalResponsesAnalyzed': 0})\\n",
        "                continue\\n",
        "\\n",
        "            positive_responses = country_data[country_data['sentiment_score'] > 0.05].shape[0]\\n",
        "            negative_responses = country_data[country_data['sentiment_score'] < -0.05].shape[0]\\n",
        "            prop_positive = positive_responses / total_responses if total_responses > 0 else 0.0\\n",
        "            prop_negative = negative_responses / total_responses if total_responses > 0 else 0.0\\n",
        "            aioi = prop_positive - prop_negative\\n",
        "\\n",
        "            freq_econ_threat = country_data['ECON_THREAT'].sum()\\n",
        "            freq_econ_opportunity = country_data['ECON_OPPORTUNITY'].sum()\\n",
        "            eai_denominator = freq_econ_threat + freq_econ_opportunity\\n",
        "            eai = freq_econ_threat / eai_denominator if eai_denominator > 0 else np.nan\\n",
        "\\n",
        "            freq_gov_reg = country_data['GOVERNANCE_REGULATION'].sum()\\n",
        "            freq_ethics_bias = country_data['ETHICS_BIAS'].sum()\\n",
        "            total_codes_applied = sum(country_data[code].sum() for code in THEMATIC_CODES.keys())\\n",
        "            geci = (freq_gov_reg + freq_ethics_bias) / total_codes_applied if total_codes_applied > 0 else np.nan\\n",
        "\\n",
        "            theme_sums = pd.Series({code: country_data[code].sum() for code in THEMATIC_CODES.keys()})\\n",
        "            theme_counts_present = theme_sums[theme_sums > 0]\\n",
        "            dss = np.nan\\n",
        "            if not theme_counts_present.empty and theme_counts_present.sum() > 0:\\n",
        "                probabilities = theme_counts_present / theme_counts_present.sum()\\n",
        "                entropy = -np.sum(probabilities * np.log2(probabilities[probabilities > 0])) \\n",
        "                num_unique_themes_present = len(theme_counts_present)\\n",
        "                if num_unique_themes_present > 1:\\n",
        "                    dss = entropy / np.log2(num_unique_themes_present)\\n",
        "                elif num_unique_themes_present == 1:\\n",
