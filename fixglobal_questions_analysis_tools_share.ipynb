        "                'TotalResponsesAnalyzed': total_responses\\n",
        "            })\\n",
        "\\n",
        "        indices_df = pd.DataFrame(country_level_indices)\\n",
        "        print(\\"\\\\n--- Calculated Segment-Level Indices (based on overall discourse) ---\\")\\n",
