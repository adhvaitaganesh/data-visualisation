        "for i in range(0,nq):\n",
        "  d = data[i]\n",
        "  m = [d[1][1],d[1][2]]\n",
        "  meta.append(m)\n",
        "  if d[1][1] == 'Poll Single Select':\n",
        "    for r in range(1,len(d)):\n",
        "      for c in range(4,len(d[0])):\n",
        "        d[r][c] = p2f(d[r][c])\n",
        "  if d[1][1] == 'Ask Opinion':\n",
        "    for r in range(1,len(d)):\n",
        "      for c in range(6,len(d[0])-3):\n",
