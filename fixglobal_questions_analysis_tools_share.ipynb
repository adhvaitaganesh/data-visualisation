        "!pip install vaderSentiment -q\\n",
        "from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\\n",
        "\\n",
        "analyzer_vader = SentimentIntensityAnalyzer()\\n",
        "\\n",
        "def get_sentiment_score(text):\\n",
        "    if not isinstance(text, str):\\n",
        "        return 0.0 \\n",
        "    vs = analyzer_vader.polarity_scores(text)\\n",
        "    return vs['compound']\\n",
        "\\n",
        "def add_sentiment_score_to_df(df, text_column='English Responses'):\\n",
        "    if text_column not in df.columns:\\n",
        "        df['sentiment_score'] = 0.0\\n",
        "        return df\\n",
        "    df['sentiment_score'] = df[text_column].apply(get_sentiment_score)\\n",
        "    return df\\n",
        "\\n",
        "print(\\"Sentiment analysis functions defined.\\")"
